# Copy to .env and fill in. Only the model provider's keys and INKLING_SECRET_KEY are required.
# On a host such as Azure App Service, set the same names as app settings instead of using a .env file.

# ---- Required: the models ----

# Which provider: azure (the recommended default: GPT on Azure AI Foundry), openai, anthropic (Claude), or
# compatible (any server that speaks OpenAI's Responses API). Fill in the keys for the one you pick.
INKLING_AI_PROVIDER=azure

# azure: your Azure AI Foundry (Azure OpenAI) resource. RESOURCE is just the name: for
# https://my-inkling.openai.azure.com it's "my-inkling".
AZURE_AI_RESOURCE=
AZURE_AI_API_KEY=

# openai (also used for voice notes and images alongside Claude, if set)
# OPENAI_API_KEY=

# anthropic (Claude)
# ANTHROPIC_API_KEY=

# compatible: the server's base URL (ending in /v1) and key; set INKLING_MODEL and INKLING_WEB_MODEL too
# INKLING_AI_BASE_URL=
# INKLING_AI_API_KEY=
# Web search is off with compatible servers unless yours supports OpenAI's web_search tool:
# INKLING_WEB_SEARCH=on
# Opt in only if the compatible endpoint accepts Responses reasoning.effort=low.
# Applies to article summaries and the tweet editor, keeping background work lightweight.
# INKLING_BACKGROUND_REASONING=true

# Encrypts everything private at rest (chat history, memory, Google tokens, linked WhatsApp, sessions).
# Keep it secret and backed up: changing or losing it makes the stored data unreadable and disconnects everyone.
# Generate with: openssl rand -base64 32
INKLING_SECRET_KEY=

# ---- Models (each provider has sensible defaults; on Azure these are deployment names) ----

# Chat model. Default gpt-5-mini, or claude-opus-5-5 with anthropic (claude-sonnet-5-5 is cheaper)
# INKLING_MODEL=gpt-5-mini
# INKLING_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Optional Pi microphone calibration, off until a source, control URL and local Whisper are configured.
# Owner-private /mic opens a 30-minute hold-to-speak page. Transcript-only by default; optional conversation below.
# Use the stable microphone node.name from wpctl inspect, never a numeric node id or speaker monitor.
# INKLING_MIC_SOURCE=alsa_input.usb-Example_Microphone-00.mono-fallback
# INKLING_MIC_CONTROL_URL=http://your-pi.local:8792
# INKLING_MIC_HOST=0.0.0.0
# INKLING_MIC_PORT=8792
# Optional diagnostic worker argv as JSON; reads the WAV on stdin and returns bounded comparison JSON.
# Trusted operator configuration only. No shell is used locally; never put keys or expected sentences here.
# INKLING_MIC_COMPARE_COMMAND=["/absolute/path/to/compare-worker"]
# Optional automatic mic review: exact model labels returned by that worker. Both must be configured.
# INKLING_MIC_REVIEW_MODEL=Primary recognizer
# INKLING_MIC_REVIEW_REFERENCE=Reference recognizer
# Optional manual mic -> normal private assistant reply. Requires a warm /microphone gateway route.
# Spoken input cannot approve outgoing drafts or change access/admin settings. Wake detection is still separate.
# INKLING_MIC_CONVERSATION=true
# Optional effort for mic conversations only. Also opts compatible Responses endpoints into reasoning.effort;
# leave unset unless your endpoint supports it. Z.ai GLM-5.3-Flash accepts low/high/max.
# INKLING_MIC_EFFORT=low
# Optional compact mic conversations: all saved notes, recent turns and on-demand tools/history retrieval.
# Ordinary conversation uses one tool-free response; tool requests keep the existing permission checks.
# INKLING_MIC_COMPACT=true
# Optional local incremental sessions, requiring the separately configured laptop backend.
# INKLING_MIC_INCREMENTAL=true
# Optional trusted local HTTPS for browser microphone permission. Keep private keys outside the repo.
# INKLING_MIC_TLS_CERT=/protected/path/mic-cert.pem
# INKLING_MIC_TLS_KEY=/protected/path/mic-key.pem
# INKLING_TTS_MODEL=gpt-4o-mini-tts

# ElevenLabs (optional): a short reply to a voice note comes back as a voice note, and urgent reminders use this
# voice. Off without a key (then reminders use INKLING_TTS_MODEL and replies stay as text).
# INKLING_ELEVENLABS_API_KEY=
# INKLING_ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
# INKLING_ELEVENLABS_MODEL=eleven_flash_v2_5
# Default FLUX.1-Kontext-pro on Azure, gpt-image-1 on OpenAI
# INKLING_IMAGE_MODEL=FLUX.1-Kontext-pro
# The model that drives the browser for website tasks. Default gpt-5.4-mini, or claude-opus-5-5 with anthropic
# INKLING_WEB_MODEL=gpt-5.4-mini

# How hard the model reasons before replying: minimal | low | medium | high
INKLING_EFFORT=medium

# Web search is billed per search; stop offering it after this many a day (across everyone)
# INKLING_DAILY_SEARCHES=50

# ---- The assistant ----

# What the assistant is called, and the word that gets its attention in groups
INKLING_NAME=inkling

# Other names that also get its attention in groups, comma-separated (e.g. an old name after renaming it)
# INKLING_ALIASES=

# Optional private laptop speech gateway. Both values are required; no cloud fallback when configured.
# INKLING_WHISPER_URL=http://127.0.0.1:8102
# INKLING_WHISPER_SECRET=generate-a-long-random-secret
# Whisper defaults to text replies; set text explicitly to disable spoken voice-note replies with any provider.
# INKLING_VOICE_REPLIES=text

# Let people who aren't on the list try it in a private chat as guests, this many messages a day each (no Google,
# calendars or websites). Off by default (0): strangers get the waiting list.
# INKLING_GUEST_MESSAGES=50

# Google invites asked for in a group go straight away (only the asker's own event, only to people on the list in the
# group and emails posted there). Off by default: they wait for the asker's yes in a private chat.
# INKLING_GROUP_INVITES_NOW=true

# Groups with someone from your list in them answer everyone there from the start (an admin can still /close one).
# Off by default: only people on the list, until an admin says /open in that group.
# INKLING_OPEN_GROUPS=true

# User id (from users.json) to text when it starts up, e.g. after a deploy
# INKLING_ANNOUNCE_TO=

# Where everything private is stored (default ./data)
# INKLING_DATA_DIR=

LOG_LEVEL=info

# ---- Web server ----

# Public HTTPS address people's browsers use for Google sign-in links and the home page (see README).
# Default http://localhost:8787, which only works on the computer running inkling.
# INKLING_PUBLIC_URL=https://inkling.example.com

# Address and port to listen on (PORT is also honoured, as set by most hosts). Use 0.0.0.0 behind a proxy or on a host.
# INKLING_HOST=127.0.0.1
# INKLING_PORT=8787

# Optional analytics: a PostHog project key (phc_..., not a personal API key) and its host. Turns on usage numbers
# (model costs and speed, tools, errors; anonymous ids, never message contents) and visit counts on the home page.
# INKLING_POSTHOG_KEY=
# INKLING_POSTHOG_HOST=https://us.i.posthog.com

# Where the source code lives, for people the waiting list or guest limits turn away (default: the upstream repo).
# INKLING_SOURCE_URL=https://github.com/you/inkling

# ---- Google (Gmail, Calendar, Drive, Docs, Sheets, Tasks; see README) ----

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional comma-separated services requested during sign-in. Default: all six.
# Include gmail, calendar or drive so the connection can identify the account.
# INKLING_GOOGLE_SERVICES=gmail
# Set false after setup to stop offering/sending new sign-in links; existing accounts still work.
# INKLING_GOOGLE_CONNECT_ENABLED=false
# Optional shared assistant sending for all registered users. No shared inbox access.
# Existing connected account: the user id that holds its OAuth token and the exact Gmail address.
# INKLING_MAIL_USER_ID=sam
# INKLING_MAIL_ACCOUNT=assistant@example.com
# Allow shared sending requests in these exact internal group chat ids (comma-separated).
# Previews and confirmations still happen in the requester's private chat.
# INKLING_MAIL_GROUPS=group-123456789
# Owner-private important Primary-mail alerts for the shared assistant mailbox. Off by default.
# Checks every 15 minutes; new mail from activation onward, at most four alerts/day between 09:00 and 22:00.
# INKLING_MAIL_REVIEW_ENABLED=true

# ---- Websites: the browser service in browser/ (see README). Off without these. ----

# INKLING_BROWSER_URL=https://browser.example.com
# Optional phone-facing base URL if INKLING_BROWSER_URL is a local SSH tunnel.
# INKLING_BROWSER_LIVE_URL=https://browser.example.com
# Browser model override; compatible providers default to INKLING_MODEL.
# INKLING_WEB_MODEL=
# Same value as the browser service's BROWSER_SECRET (32+ characters: openssl rand -hex 32)
# INKLING_BROWSER_SECRET=

# ---- Native local music (group members, owner in private chat; off until configured). ----

# Dedicated music service: see scripts/inkling-music.service and README.
# Socket parent must be a private directory (700) owned by the service user.
# INKLING_MUSIC_SOCKET=/run/user/1000/inkling-music/control.sock
# Optional exact speaker description from: mpv --audio-device=help
# INKLING_MUSIC_SPEAKER=My Bluetooth Speaker
# INKLING_MPV=/usr/bin/mpv
# INKLING_YTDLP=/usr/local/bin/yt-dlp
# For another player, optional fixed executable/argument arrays (native socket takes priority):
# INKLING_MUSIC_COMMANDS='{"play":["/absolute/path/to/player","play","{query}"],"status":["/absolute/path/to/player","status"]}'

# ---- Self-changes (see README). Off unless both are set. ----

# Your own copy of this repository, as owner/name
# INKLING_GITHUB_REPO=
# A fine-grained GitHub token for that repo only: Actions, Contents and Pull requests read/write
# INKLING_GITHUB_TOKEN=
# General coding: separate Codex laptop worker, owner's private chat only. Off without both values.
INKLING_CODING_URL=
INKLING_CODING_SECRET=

# Optional owner-only maintenance notices from installed host backup/review/deployment jobs.
# INKLING_OPERATIONS_NOTIFICATIONS=true

# Public article intake, separate from WhatsApp. Off until enabled; never sends messages.
# Start with npm run reading:worker. See docs/reading-intake.md.
# INKLING_READING_ENABLED=true
# INKLING_READING_DAILY=10
# INKLING_READING_BROWSER_DAILY=2
# INKLING_READING_TIMEZONE=UTC
# Optional comma-separated interest keywords, used only for article selection.
# INKLING_READING_INTERESTS=
# Optional absolute JSON file replacing the built-in source list.
# INKLING_READING_SOURCES_FILE=

# Optional background reading posts. Fixed group only; no private chat/email/memory content.
# Registered owner's user ID and explicit activation time are required. Off without all three.
# INKLING_READING_SHARE_GROUP=group-1234567890
# INKLING_READING_SHARE_BY=owner-user-id
# INKLING_READING_SHARE_SINCE=2026-01-01T00:00:00Z
# Optional owner-only article memory, available through recall in that owner's private chat.
# Existing unowned notes need an explicit operator migration; never reassigned automatically.
# INKLING_READING_MEMORY_USER_ID=owner-user-id

# Private copy-and-paste tweet editor, off until explicitly configured for the registered owner.
# No X credentials, API requests or browser posting. Existing AI inference is still billed normally.
# Up to two proactive suggestions daily, four-hour gap, 09:00–22:00 in the owner's timezone.
# INKLING_TWEETS_ENABLED=true
# INKLING_TWEETS_USER_ID=owner-user-id
