# Private by default. Containers override the host to 0.0.0.0.
BROWSER_HOST=127.0.0.1
PORT=8099
# Generate separately, then set the same value as INKLING_BROWSER_SECRET on Inkling.
BROWSER_SECRET=
BROWSER_MAX_SESSIONS=2
BROWSER_MAX_PAGES=4
BROWSER_SESSION_IDLE_MINUTES=30
# BROWSER_LOCALE=en-GB
# BROWSER_TIMEZONE=Asia/Kolkata
