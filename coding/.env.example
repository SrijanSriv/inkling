# Laptop worker, kept outside the project workspace. Generate each secret independently.
INKLING_CODING_SECRET=
INKLING_CODING_STATE_KEY=
INKLING_CODING_CODEX_VERSION=0.162.1
# Actual pinned Codex binary and approved tool installation roots, never the whole home directory.
INKLING_CODING_BIN=
INKLING_CODING_TOOL_ROOTS=
# Optional JSON mapping of project aliases to source folders. Imports once, without modifying originals.
# INKLING_CODING_IMPORTS_FILE=/path/to/imports.json
# Optional static index.html preview on home Wi-Fi, no backend servers.
# INKLING_CODING_PREVIEW_URL=http://laptop-address:8101
# INKLING_CODING_PREVIEW_HOST=0.0.0.0
